# Sourced by init.sh and by the post-edit hook. Plain shell assignments only.
HARNESS_FILES="CLAUDE.md AGENTS.md CHECKPOINTS.md progress/current.md odd/tasks"

# --- Python (venv) ---
ENV_CHECK_CMD=".venv/bin/python --version"
TEST_CMD=".venv/bin/python -m pytest -q -x"
AUDIT_CMD=".venv/bin/pip-audit --skip-editable --progress-spinner off"
